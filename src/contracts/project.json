{
  "name": "contracts",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/contracts/generate.mjs --write"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/src/backend/src/komaquill/interfaces/http/**/*.py",
        "{workspaceRoot}/src/backend/src/komaquill/domain/conversations/models.py",
        "{workspaceRoot}/openapi-ts.config.ts",
        "{workspaceRoot}/src/backend/src/komaquill/domain/**/*.py",
        "{workspaceRoot}/tools/contracts/export.py",
        "{workspaceRoot}/tools/contracts/generate.mjs",
        "{workspaceRoot}/src/frontend/src/api/generated/**/*",
        "{workspaceRoot}/src/backend/uv.lock"
      ],
      "options": {
        "command": "node tools/contracts/generate.mjs"
      }
    }
  }
}
