{
  "name": "backend",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "python",
        "{workspaceRoot}/tools/checks/worker_lock.py",
        "{workspaceRoot}/tests/**/*.py"
      ],
      "options": {
        "commands": [
          "node tools/runtime/python.mjs -m ruff check src/backend/src tests",
          "node tools/runtime/python.mjs -m ruff format --check src/backend/src tests",
          "node tools/runtime/python.mjs -c \"from importlinter.cli import lint_imports; raise SystemExit(lint_imports(cache_dir='.artifacts/cache/import-linter'))\"",
          "node tools/runtime/python.mjs -m tools.checks.worker_lock"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": ["python"],
      "options": {
        "command": "node tools/runtime/python.mjs -m mypy src/backend/src --cache-dir .artifacts/cache/mypy/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "{workspaceRoot}/tests/backend/**/*.test.mjs"],
      "options": {
        "command": "node --test tests/backend/unit/comfyui/preparation.test.mjs"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "projects": ["frontend"],
          "target": "build"
        }
      ],
      "options": {
        "commands": [
          "node tools/runtime/python.mjs tools/packaging/build.py",
          "node tools/runtime/python.mjs -m tools.checks.distribution"
        ],
        "parallel": false
      },
      "inputs": [
        "python",
        "{workspaceRoot}/tools/packaging/build.py",
        "{workspaceRoot}/tools/checks/distribution.py",
        "{workspaceRoot}/tests/backend/support/acceptance.py",
        "{workspaceRoot}/tests/backend/support/comfy.py",
        {
          "dependentTasksOutputFiles": "**/*"
        },
        "{workspaceRoot}/tools/checks/installed_wheel.py",
        "{workspaceRoot}/tests/system/e2e/package/test_installed_wheel.py"
      ],
      "outputs": [
        "{workspaceRoot}/.artifacts/dist/*.whl",
        "{workspaceRoot}/.artifacts/dist/*.tar.gz"
      ],
      "configurations": {}
    },
    "package": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node tools/runtime/python.mjs -m tools.checks.installed_wheel --dist-dir .artifacts/dist --report-dir .artifacts/records/reports/package"
      }
    }
  }
}
