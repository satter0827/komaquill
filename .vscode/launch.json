{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Session",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "start"
      ],
      "subProcess": false
    },
    {
      "name": "Open Generator",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "open",
        "--view",
        "${input:view}"
      ],
      "subProcess": false
    },
    {
      "name": "Generate Image",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "generate",
        "--prompt",
        "${input:prompt}"
      ],
      "subProcess": false
    },
    {
      "name": "Resume Story",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "resume",
        "${input:renderId}"
      ],
      "subProcess": false
    },
    {
      "name": "Show Story",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "show",
        "${input:storyId}"
      ],
      "subProcess": false
    },
    {
      "name": "Plan Story (LM Studio)",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "plan",
        "${input:storyFile}",
        "--images",
        "${input:storyImages}",
        "--allow-real-llm",
        "--llm-profile",
        "lmstudio-4b"
      ],
      "subProcess": false
    },
    {
      "name": "Generate Story (LM Studio)",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "generate",
        "${input:storyFile}",
        "--images",
        "${input:storyImages}",
        "--allow-real-llm",
        "--llm-profile",
        "lmstudio-4b"
      ],
      "subProcess": false
    },
    {
      "name": "Prepare Workflow",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "prepare",
        "${input:workflow}"
      ],
      "subProcess": false
    },
    {
      "name": "Collect Results",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "collect"
      ],
      "subProcess": false
    },
    {
      "name": "Show Status",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "status"
      ],
      "subProcess": false
    },
    {
      "name": "Check Connection",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "doctor"
      ],
      "subProcess": false
    },
    {
      "name": "Show Logs",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "logs",
        "--follow"
      ],
      "subProcess": false
    },
    {
      "name": "Stop Session",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stop",
        "${input:stopMode}"
      ],
      "subProcess": false
    },
    {
      "name": "Clean Generated Files",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "clean",
        "${input:cleanMode}"
      ],
      "subProcess": false
    },
    {
      "name": "Run CLI with Arguments",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": "${command:pickArgs}",
      "subProcess": false
    },
    {
      "name": "Debug Session",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "start",
        "--foreground",
        "--no-open"
      ],
      "subProcess": false
    }
  ],
  "inputs": [
    {
      "id": "view",
      "type": "pickString",
      "description": "Choose App Mode or the full Node Graph editor",
      "options": [
        {
          "label": "App Mode",
          "value": "app"
        },
        {
          "label": "Node Graph",
          "value": "graph"
        }
      ],
      "default": "app"
    },
    {
      "id": "prompt",
      "type": "promptString",
      "description": "Describe the image to generate"
    },
    {
      "id": "stopMode",
      "type": "pickString",
      "description": "Choose how to stop the session",
      "options": [
        {
          "label": "Wait for Results",
          "value": "--no-force"
        },
        {
          "label": "Stop Without Waiting",
          "value": "--force"
        }
      ],
      "default": "--no-force"
    },
    {
      "id": "workflow",
      "type": "promptString",
      "description": "Enter the workflow JSON path"
    },
    {
      "id": "cleanMode",
      "type": "pickString",
      "description": "Preview or clean disposable generated files",
      "options": [
        {
          "label": "Preview",
          "value": "--dry-run"
        },
        {
          "label": "Clean",
          "value": "--no-dry-run"
        }
      ],
      "default": "--dry-run"
    },
    {
      "id": "storyFile",
      "type": "promptString",
      "description": "Enter the UTF-8 story file path"
    },
    {
      "id": "storyImages",
      "type": "pickString",
      "description": "Choose the number of scenes and main images",
      "options": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ],
      "default": "4"
    },
    {
      "id": "storyId",
      "type": "promptString",
      "description": "Enter the story ID"
    },
    {
      "id": "renderId",
      "type": "promptString",
      "description": "Enter the rendering ID to resume with its original settings"
    }
  ]
}
