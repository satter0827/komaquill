{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "PYTHONUTF8": "1",
      "PYTHONPYCACHEPREFIX": "${workspaceFolder}/.artifacts/cache/pycache",
      "KOMAQUILL_UV": "${workspaceFolder}/.artifacts/runtime/uv/uv.exe"
    }
  },
  "tasks": [
    {
      "label": "Setup Environment",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/bootstrap/setup.ps1",
        "-InstallExtensions"
      ],
      "problemMatcher": []
    },
    {
      "label": "Check Project",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/check.py"
      ]
    },
    {
      "label": "Build Package",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Distributions",
        "Check Distributions"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Check Distributions",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/check_package.py"
      ],
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "Build Distributions",
      "type": "process",
      "command": "${workspaceFolder}/.artifacts/runtime/uv/uv.exe",
      "args": [
        "build",
        "--out-dir",
        "${workspaceFolder}/.artifacts/dist"
      ],
      "hide": true,
      "problemMatcher": []
    }
  ]
}
