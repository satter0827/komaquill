{
  "name": "scripts",
  "implicitDependencies": ["backend", "tools"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node tools/runtime/python.mjs -m ruff check scripts",
          "node tools/runtime/python.mjs -m ruff format --check scripts",
          "node node_modules/prettier/bin/prettier.cjs --check scripts",
          "node --check scripts/acceptance/web.mjs",
          "node --check scripts/acceptance/ui.mjs"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/runtime/python.mjs -m mypy scripts --cache-dir .artifacts/cache/mypy/scripts"
      }
    }
  }
}
