{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "PYTHONUTF8": "1",
      "PYTHONPYCACHEPREFIX": "${workspaceFolder}/.artifacts/cache/pycache",
      "KOMAQUILL_UV": "${workspaceFolder}/.artifacts/runtime/uv/uv.exe"
    }
  },
  "tasks": [
    {
      "label": "Setup Environment",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/bootstrap/setup.ps1",
        "-InstallExtensions"
      ],
      "problemMatcher": []
    },
    {
      "label": "Check Project",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/check.py",
        "--level",
        "${input:qualityLevel}"
      ]
    },
    {
      "label": "Build Package",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/check.py",
        "--check",
        "distribution"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "inputs": [
    {
      "id": "qualityLevel",
      "type": "pickString",
      "description": "Choose the cumulative check level",
      "options": [
        "2",
        "1",
        "3"
      ],
      "default": "2"
    }
  ]
}
