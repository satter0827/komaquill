{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Session",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "start",
        "--model",
        "${input:imageModel}"
      ],
      "subProcess": false
    },
    {
      "name": "Open Generator",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "open",
        "--view",
        "${input:view}",
        "--model",
        "${input:imageModel}",
        "--operation",
        "${input:imageOperation}"
      ],
      "subProcess": false
    },
    {
      "name": "Generate Image",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "generate",
        "--prompt",
        "${input:prompt}",
        "--model",
        "${input:imageModel}"
      ],
      "subProcess": false
    },
    {
      "name": "Generate Image from File",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "generate",
        "--input-file",
        "${input:imageInputFile}"
      ],
      "subProcess": false
    },
    {
      "name": "Resume Story",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "resume",
        "${input:renderId}"
      ],
      "subProcess": false
    },
    {
      "name": "Render Saved Story",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "render",
        "${input:storyId}",
        "--render-file",
        "${input:renderFile}"
      ],
      "subProcess": false
    },
    {
      "name": "List Stories",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "list"
      ],
      "subProcess": false
    },
    {
      "name": "Show Story",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "show",
        "${input:storyId}"
      ],
      "subProcess": false
    },
    {
      "name": "Export Story",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "export",
        "${input:storyId}",
        "--detail",
        "${input:evidenceDetail}"
      ],
      "subProcess": false
    },
    {
      "name": "Plan Story (LM Studio)",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "plan",
        "${input:storyFile}",
        "--allow-real-llm"
      ],
      "subProcess": false
    },
    {
      "name": "Generate Story (LM Studio)",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stories",
        "generate",
        "${input:storyFile}",
        "--allow-real-llm"
      ],
      "subProcess": false
    },
    {
      "name": "Prepare Workflow",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "prepare",
        "${input:workflow}"
      ],
      "subProcess": false
    },
    {
      "name": "Collect Results",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "collect"
      ],
      "subProcess": false
    },
    {
      "name": "Show Status",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "status"
      ],
      "subProcess": false
    },
    {
      "name": "Check Connection",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "doctor"
      ],
      "subProcess": false
    },
    {
      "name": "Show Logs",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "logs",
        "--follow"
      ],
      "subProcess": false
    },
    {
      "name": "Stop Session",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "stop",
        "${input:stopMode}"
      ],
      "subProcess": false
    },
    {
      "name": "Clean Generated Files",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "clean",
        "${input:cleanMode}"
      ],
      "subProcess": false
    },
    {
      "name": "Run CLI with Arguments",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": "${command:pickArgs}",
      "subProcess": false
    },
    {
      "name": "Debug Session",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "args": [
        "start",
        "--foreground",
        "--no-open",
        "--model",
        "${input:imageModel}"
      ],
      "subProcess": false
    }
  ],
  "inputs": [
    {
      "id": "view",
      "type": "pickString",
      "description": "Choose App Mode or the full Node Graph editor",
      "options": [
        {
          "label": "App Mode",
          "value": "app"
        },
        {
          "label": "Node Graph",
          "value": "graph"
        }
      ],
      "default": "app"
    },
    {
      "id": "prompt",
      "type": "promptString",
      "description": "Describe the image to generate"
    },
    {
      "id": "stopMode",
      "type": "pickString",
      "description": "Choose how to stop the session",
      "options": [
        {
          "label": "Wait for Results",
          "value": "--no-force"
        },
        {
          "label": "Stop Without Waiting",
          "value": "--force"
        }
      ],
      "default": "--no-force"
    },
    {
      "id": "workflow",
      "type": "promptString",
      "description": "Enter the workflow JSON path"
    },
    {
      "id": "cleanMode",
      "type": "pickString",
      "description": "Preview or clean disposable generated files",
      "options": [
        {
          "label": "Preview",
          "value": "--dry-run"
        },
        {
          "label": "Clean",
          "value": "--no-dry-run"
        }
      ],
      "default": "--dry-run"
    },
    {
      "id": "storyFile",
      "type": "promptString",
      "description": "Enter the UTF-8 story file path"
    },
    {
      "id": "storyId",
      "type": "promptString",
      "description": "Enter the story ID"
    },
    {
      "id": "renderId",
      "type": "promptString",
      "description": "Enter the rendering ID to resume with its original settings"
    },
    {
      "id": "evidenceDetail",
      "type": "pickString",
      "description": "Choose summary for comparison or full for complete records",
      "options": [
        {
          "label": "Summary",
          "value": "summary"
        },
        {
          "label": "Full Records",
          "value": "full"
        }
      ],
      "default": "summary"
    },
    {
      "id": "imageInputFile",
      "type": "promptString",
      "description": "Enter the image-input JSON file path"
    },
    {
      "id": "renderFile",
      "type": "promptString",
      "description": "Scene render settings JSON file",
      "default": "render.json"
    },
    {
      "id": "imageModel",
      "type": "pickString",
      "description": "Choose an enabled image model",
      "options": [
        "klein-4b",
        "klein-9b",
        "wai-illustrious"
      ],
      "default": "klein-4b"
    },
    {
      "id": "imageOperation",
      "type": "pickString",
      "description": "Choose generation or reference editing",
      "options": [
        "generate",
        "edit"
      ],
      "default": "generate"
    }
  ]
}
