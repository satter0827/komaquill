{
  "name": "frontend",
  "implicitDependencies": [
    "contracts"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "frontend",
        "{workspaceRoot}/tests/frontend/**/*"
      ],
      "options": {
        "command": "pnpm --dir src/frontend lint"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": [
        "frontend",
        "{workspaceRoot}/tests/frontend/**/*"
      ],
      "options": {
        "command": "pnpm --dir src/frontend typecheck"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "frontend",
        "{workspaceRoot}/tests/frontend/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/.artifacts/build/frontend"
      ],
      "options": {
        "command": "pnpm --dir src/frontend build"
      },
      "dependsOn": [
        {
          "projects": [
            "contracts"
          ],
          "target": "test"
        }
      ]
    }
  }
}
