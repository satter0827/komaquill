{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Session",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "start"
      ],
      "subProcess": false
    },
    {
      "name": "Open Generator",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "open",
        "--view",
        "${input:view}"
      ],
      "subProcess": false
    },
    {
      "name": "Generate Image",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "generate",
        "--prompt",
        "${input:prompt}"
      ],
      "subProcess": false
    },
    {
      "name": "Collect Results",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "collect"
      ],
      "subProcess": false
    },
    {
      "name": "Show Status",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "status"
      ],
      "subProcess": false
    },
    {
      "name": "Check Connection",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "doctor"
      ],
      "subProcess": false
    },
    {
      "name": "Stop Session",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "stop",
        "${input:stopMode}"
      ],
      "subProcess": false
    },
    {
      "name": "Run CLI with Arguments",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": "${command:pickArgs}",
      "subProcess": false
    }
  ],
  "inputs": [
    {
      "id": "view",
      "type": "pickString",
      "description": "Choose App Mode or the full Node Graph editor",
      "options": [
        {
          "label": "App Mode",
          "value": "app"
        },
        {
          "label": "Node Graph",
          "value": "graph"
        }
      ],
      "default": "app"
    },
    {
      "id": "prompt",
      "type": "promptString",
      "description": "Describe the image to generate"
    },
    {
      "id": "stopMode",
      "type": "pickString",
      "description": "Choose how to stop the session",
      "options": [
        {
          "label": "Wait for Results",
          "value": "--no-force"
        },
        {
          "label": "Stop Without Waiting",
          "value": "--force"
        }
      ],
      "default": "--no-force"
    }
  ]
}
