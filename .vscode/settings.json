{
  "python.defaultInterpreterPath": "${workspaceFolder}/.artifacts/runtime/venv",
  "python.envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests/unit",
    "tests/integration"
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "files.watcherExclude": {
    "**/.artifacts/**": true
  },
  "search.exclude": {
    "**/.artifacts/**": true
  },
  "flake8.enabled": false
}
