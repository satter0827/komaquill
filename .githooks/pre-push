#!/bin/sh
# Invoke the shared secret check using an available shell.
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File scripts/security.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -File scripts/security.ps1
else
    exec python scripts/security.py
fi
