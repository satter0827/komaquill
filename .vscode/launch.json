{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start ComfyUI (Colab)",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "start"
      ]
    },
    {
      "name": "Open ComfyUI",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "open",
        "--view",
        "${input:view}"
      ]
    },
    {
      "name": "Generate Image",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "generate",
        "--prompt",
        "${input:prompt}"
      ]
    },
    {
      "name": "Collect Results",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "collect"
      ]
    },
    {
      "name": "Show Status",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "status"
      ]
    },
    {
      "name": "Check ComfyUI",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "doctor"
      ]
    },
    {
      "name": "Stop ComfyUI",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": [
        "stop",
        "${input:stopMode}"
      ]
    },
    {
      "name": "Run CLI with Arguments",
      "type": "debugpy",
      "request": "launch",
      "module": "komaquill",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.artifacts/runtime/vscode.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/.artifacts/runtime/venv/Scripts/python.exe",
      "args": "${command:pickArgs}"
    }
  ],
  "inputs": [
    {
      "id": "view",
      "type": "pickString",
      "description": "Choose the ComfyUI view",
      "options": [
        {
          "label": "App Mode",
          "value": "app"
        },
        {
          "label": "Node Graph",
          "value": "graph"
        }
      ],
      "default": "app"
    },
    {
      "id": "prompt",
      "type": "promptString",
      "description": "Describe the image to generate"
    },
    {
      "id": "stopMode",
      "type": "pickString",
      "description": "Choose how to stop ComfyUI",
      "options": [
        {
          "label": "Wait for Results",
          "value": "--no-force"
        },
        {
          "label": "Stop Without Waiting",
          "value": "--force"
        }
      ],
      "default": "--no-force"
    }
  ]
}
