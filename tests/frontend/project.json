{
  "name": "frontend-tests",
  "implicitDependencies": ["frontend", "contracts", "tools"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default"],
      "options": {
        "commands": [
          "node node_modules/vitest/vitest.mjs run --config src/frontend/vite.config.ts",
          "node --test tests/frontend/structure/locales/catalogs.test.mjs"
        ],
        "parallel": false
      }
    }
  }
}
