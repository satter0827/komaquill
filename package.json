{
  "name": "komaquill-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "test:web": "node tools/runtime/nx.mjs run e2e:test",
    "review:web": "node tools/runtime/nx.mjs run e2e:review",
    "dev": "node tools/development/server.mjs",
    "check": "node tools/runtime/python.mjs tools/checks/run.py --scope daily",
    "check:ci": "node tools/runtime/python.mjs tools/checks/run.py --scope ci",
    "check:all": "node tools/runtime/python.mjs tools/checks/run.py --scope all",
    "build": "node tools/runtime/nx.mjs run backend:package",
    "contracts": "node tools/runtime/nx.mjs run contracts:generate",
    "test:frontend": "vitest run --config src/frontend/vite.config.ts",
    "lint:frontend": "eslint src/frontend/src tests/frontend --config src/frontend/eslint.config.js && prettier --check src/frontend/src tests/frontend src/frontend/vite.config.ts",
    "verify:live": "node tools/runtime/python.mjs -m scripts.acceptance.run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "9.39.5",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.56.0",
    "@tanstack/react-query": "5.105.0",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "atomically": "^2.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "27.4.0",
    "msw": "2.15.0",
    "nx": "24.0.4",
    "prettier": "^3.6.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "7.18.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "type": "module"
}
